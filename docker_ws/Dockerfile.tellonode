# Base Image ROS2 Humble
FROM ros:humble-ros-base

# Previene prompt interattivi durante l'installazione di apt
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Installazione dipendenze di sistema, pacchetti video FFmpeg e strumenti di sviluppo
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    git \
    wget \
    curl \
    nano \
    net-tools \
    iputils-ping \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Aggiornamento pip e setuptools
RUN python3 -m pip install --upgrade pip setuptools wheel

# Installazione librerie di base per Reti Neurali & Machine Learning (PyTorch, Numpy, SciPy, skrl, ONNX)
RUN python3 -m pip install --no-cache-dir \
    torch \
    torchvision \
    torchaudio \
    numpy \
    scipy \
    matplotlib \
    pandas \
    onnx \
    onnxruntime \
    skrl

# Installazione librerie per l'interfaccia web del position_controller
# (FastAPI + uvicorn con supporto WebSocket per lo stato in tempo reale
# del drone, servito nello stesso processo del nodo ROS2).
RUN python3 -m pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    websockets

# Installazione librerie per Drone Tello usate nel progetto:
# - djitellopy (UNICA libreria drone: comandi, rc control, telemetria SDK)
#   tellopy/TelloPy RIMOSSA: non convive con djitellopy sullo stesso drone
#   (entrando in modalita' SDK il firmware smette di alimentare il flusso
#   di log binario "app" da cui tellopy leggeva il giroscopio).
# - av (PyAV per decodifica video H.264 dallo socket UDP del Tello)
# - opencv-python-headless (per elaborazione frame immagini)
RUN python3 -m pip install --no-cache-dir \
    djitellopy \
    av \
    opencv-python-headless

# Installazione pacchetti ROS2 supplementari
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-cv-bridge \
    ros-humble-vision-opencv \
    ros-humble-image-transport \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-std-msgs \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    && rm -rf /var/lib/apt/lists/*

# Configurazione del workspace ROS2
WORKDIR /ros_workspace

# Sourcing automatico dell'ambiente ROS2 Humble in bash
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

# Porte UDP per comunicazione socket con il drone Tello:
# 8889: Comandi SDK (UDP)
# 8890: Telemetria / Stato del drone (UDP)
# 11111: Streaming video H.264 (UDP)
EXPOSE 8889/udp 8890/udp 11111/udp

# Porta TCP per l'interfaccia web del position_controller (FastAPI/uvicorn +
# WebSocket di stato). Ininfluente se il container gira con --network host
# (porta gia' condivisa con l'host), ma dichiarata per chiarezza nel caso
# in futuro si cambi modalita' di rete.
EXPOSE 8080/tcp

CMD ["bash"]