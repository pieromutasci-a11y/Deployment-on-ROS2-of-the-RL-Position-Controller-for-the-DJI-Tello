# Base: ROS2 Humble
FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Dipendenze di sistema, FFmpeg e strumenti di sviluppo
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    python3-colcon-common-extensions \
    python3-rosdep \
    git \
    wget \
    curl \
    nano \
    net-tools \
    iputils-ping \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# pip aggiornato
RUN python3 -m pip install --upgrade pip setuptools wheel

# Python: PyTorch, NumPy/SciPy, skrl, ONNX
RUN python3 -m pip install --no-cache-dir \
    torch \
    torchvision \
    torchaudio \
    numpy \
    scipy \
    matplotlib \
    pandas \
    onnx \
    onnxruntime \
    skrl

# Python: interfaccia web (FastAPI + uvicorn/WebSocket)
RUN python3 -m pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    websockets

# Python: Tello (djitellopy e' l'unica libreria drone: tellopy non convive con essa), PyAV, OpenCV
RUN python3 -m pip install --no-cache-dir \
    djitellopy \
    av \
    opencv-python-headless

# Pacchetti ROS2 supplementari
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-cv-bridge \
    ros-humble-vision-opencv \
    ros-humble-image-transport \
    ros-humble-sensor-msgs \
    ros-humble-geometry-msgs \
    ros-humble-std-msgs \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    && rm -rf /var/lib/apt/lists/*

# Workspace e sourcing automatico di ROS2
WORKDIR /ros_workspace

RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

# Porte UDP del Tello: 8889 comandi, 8890 stato, 11111 video
EXPOSE 8889/udp 8890/udp 11111/udp

# Porta TCP dell'interfaccia web (irrilevante con --network host)
EXPOSE 8080/tcp

CMD ["bash"]